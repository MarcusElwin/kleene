{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "package-name": "kleene",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='kleene' || @.name.value=='kleene-algebra' || @.name.value=='kleene-core' || @.name.value=='kleene-daemon' || @.name.value=='kleene-difftest' || @.name.value=='kleene-exec' || @.name.value=='kleene-harness' || @.name.value=='kleene-llm' || @.name.value=='kleene-sql' || @.name.value=='kleene-store' || @.name.value=='kleene-tools' || @.name.value=='kleene-trace' || @.name.value=='kleene-tui')].version"
        }
      ]
    }
  }
}
