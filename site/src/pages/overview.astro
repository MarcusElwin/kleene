      <a href="/plots/learning_curve.svg"><img src="/plots/learning_curve.svg" alt="Learning curve plot" loading="lazy" /></a>
      <a href="/plots/cost_parity.svg"><img src="/plots/cost_parity.svg" alt="Cost parity plot" loading="lazy" /></a>
