---
import Base from "../layouts/Base.astro";
import Terminal from "../components/Terminal.astro";
import { loadRows, aggregate, RUNS, MODES, PACK_ORDER } from "../lib/bench";

const rows = loadRows();
const cells = aggregate(rows);
const packs = PACK_ORDER.filter((p) => cells.some((c) => c.pack === p));

const MODELS = RUNS.map((r) => ({ id: r.model, label: r.label, date: r.date, plots: r.plots, csvs: [r.csv, ...(r.csvs ?? [])], note: r.note }));
const HARD = ["coding", "memo-rubric", "logbook-hard"];
const DATA = JSON.stringify({ cells, packs, modes: MODES, models: MODELS, hard: HARD });
const PLOTS = [
  ["learning_curve.svg", "Learning curve", "task number against rolling-5 accuracy, one line per run; a learning line that rises while frozen stays flat is the playbook working"],
  ["cost_parity.svg", "Cost parity", "cumulative dollars against cumulative accuracy; at equal spend, which mode is higher"],
  ["calls_vs_difficulty.svg", "Calls against difficulty", "task rating against calls made, solved and failed as two series"],
  ["estimate_accuracy.svg", "Estimate accuracy", "the planner's estimated calls against the calls a statement made; on the diagonal is exact"],
  ["plan_space.svg", "Plan space", "relations joined against join orders considered, one point per statement"],
] as const;
---
<Base title="Benchmarks · Kleene" description="What kleene bench measured on real models: pass rate, calls and dollars per task across packs, modes and models, with filters.">
  <div class="prose wide" id="bench" data-bench={DATA}>
    <h1>Benchmarks</h1>
    <p class="dim">Three models, seven task packs, three modes. Every number is computed from the per-task rows under <code>plots/</code>, so a run that lands in the repository lands here. Pick a view below; the detail folds out underneath.</p>

    <div class="modes" role="list" aria-label="The three modes">
      <div role="listitem" style="--c:#cba6f7"><b>learning</b><span>Kleene with the playbook on. Against frozen it isolates the playbook.</span></div>
      <div role="listitem" style="--c:#fab387"><b>frozen</b><span>Kleene with the playbook off, the control. Against plain it isolates the SQL abstraction.</span></div>
      <div role="listitem" style="--c:#74c7ec"><b>plain</b><span>A tool-calling agent, no SQL, same model, tools and budget. The baseline.</span></div>
    </div>

    <div class="toolbar" id="toolbar">
      <div class="trow">
        <span class="flabel">show</span>
        <span class="chips" data-presets>
          <button type="button" class="chip" data-preset="all">everything</button>
          <button type="button" class="chip" data-preset="hard">hard packs</button>
          <button type="button" class="chip" data-preset="playbook">playbook effect</button>
          <button type="button" class="chip" data-preset="abstraction">SQL vs plain</button>
        </span>
        <span class="flabel">metric</span>
        <span class="seg" role="radiogroup" aria-label="Metric" data-metric>
          <button type="button" role="radio" data-m="pass">pass rate</button>
          <button type="button" role="radio" data-m="dollars">$ / task</button>
          <button type="button" role="radio" data-m="calls">calls / task</button>
          <button type="button" role="radio" data-m="seconds">s / task</button>
        </span>
        <button type="button" class="reset" id="reset">reset</button>
      </div>
      <details class="more" id="more">
        <summary>filter by model, mode and pack <span class="count" id="fcount"></span></summary>
        <div class="trow">
          <div class="fgroup"><span class="flabel">model</span><span class="chips" data-filter="model"></span></div>
          <div class="fgroup"><span class="flabel">mode</span><span class="chips" data-filter="mode"></span></div>
          <div class="fgroup"><span class="flabel">pack</span><span class="chips" data-filter="pack"></span></div>
        </div>
        <p class="hint dim">Click a chip to toggle it, shift-click to show only that one. The view is in the address bar, so a filtered page can be linked.</p>
      </details>
    </div>

    <div class="tiles" id="tiles"></div>

    <div class="matrix-wrap">
      <table class="matrix" id="matrix" aria-label="Results by pack and model"><thead></thead><tbody></tbody></table>
    </div>
    <p class="dim small" id="matrix-note"></p>

    <details class="section" open>
      <summary><b>What the numbers say</b></summary>
      <ul>
        <li><b>The four original packs are saturated at the top.</b> Opus 5.5 solves every task of terminal, oolong-like, finance-synthetic and legal-synthetic in every mode, so they compare cost only, and the plain agent wins there: every context fits in one prompt, and the SQL abstraction pays for a catalog, a planner and rendered results on every turn.</li>
        <li><b>The playbook cuts calls.</b> Learning against frozen on Opus: terminal 2.2 to 1.3, oolong 4.9 to 3.9, finance 3.5 to 2.4, legal 12.7 to 10.6 calls a task. Only oolong and legal adopted entries; on terminal and finance the gate rejected every candidate, so their difference is run-to-run variance.</li>
        <li><b>The gate is the cost.</b> Each candidate is replayed on three earlier tasks in both arms. Those replays are recorded in <code>playbook_evals</code>, not here: about $34 of the Opus run's $44 on the original packs, and $9 on top of $7 for coding and memo-rubric.</li>
        <li><b>The hard packs separate on accuracy.</b> Coding: Opus 12/12 in every mode, Luna 10 to 11, Haiku 2 to 4. Memo-rubric is the one pack where Opus trails Luna, and learning made Opus worse there (10 to 4 solved) while it made Luna better (8 to 18). Logbook-hard is where frozen Kleene beats plain outright: Luna 7/10 against 3/10.</li>
        <li><b>Not run yet:</b> logbook-hard on Opus 5.5. The caveats in full are in <a href="/docs/writeup/#4-what-the-benchmarks-measured">the write-up</a>.</li>
      </ul>
    </details>

    <details class="section" id="sec-pareto" open>
      <summary><b>Pass rate against cost</b> <span class="dim">one panel per pack</span></summary>
      <p class="dim small">Colour is the mode and the shape is the model: {MODELS.map((m, i) => `${["a circle", "a diamond", "a triangle", "a square"][i] ?? "a square"} is ${m.label}`).join(", ")}. Up and to the left is better. Hover or tap a mark for its numbers; click to pin.</p>
      <div class="legend" id="legend"></div>
      <div class="panels" id="panels"></div>
    </details>

    <details class="section" id="sec-bars">
      <summary><b>Calls per task</b> <span class="dim">by pack and mode, one chart per model</span></summary>
      <p class="dim small">The playbook's effect shows in calls: learning takes fewer than frozen wherever entries were adopted. The plain agent answers the short packs in one call, because every context fits in one prompt.</p>
      <div id="bars"></div>
    </details>

    <details class="section" id="sec-table">
      <summary><b>Every cell</b> <span class="dim">the full table, click a header to sort</span></summary>
      <div class="table-wrap">
        <table class="results" id="table">
          <thead><tr>
            <th data-sort="pack">pack</th><th data-sort="mode">mode</th><th data-sort="label">model</th>
            <th data-sort="pass" class="n">solved</th><th data-sort="dollarsPerTask" class="n">$ / task</th><th data-sort="dollars" class="n">total $</th>
            <th data-sort="callsPerTask" class="n">calls / task</th><th data-sort="tokensPerTask" class="n">tokens / task</th><th data-sort="secondsPerTask" class="n">s / task</th>
          </tr></thead>
          <tbody></tbody>
        </table>
      </div>
      <p class="dim small">The same table, as Markdown, is in <a href="https://github.com/MarcusElwin/kleene/blob/main/plots/results/results.md">plots/results/results.md</a>; the rows behind it are the CSVs listed under each model below.</p>
    </details>

    <details class="section" id="sec-packs">
      <summary><b>The packs</b> <span class="dim">what each one asks and how it is graded</span></summary>
      <div class="table-wrap">
      <table>
        <thead><tr><th>pack</th><th>tasks</th><th>what the model gets, what it must produce</th><th>oracle</th><th>stands in for</th></tr></thead>
        <tbody>
          <tr><td><code>terminal</code></td><td>6</td><td>a workspace and an instruction (create a file, count lines, rename, sum a CSV column); files left behind and a one-row <code>FINAL</code></td><td>shell</td><td>Terminal-Bench</td></tr>
          <tr><td><code>oolong-like</code></td><td>20</td><td>dated meeting notes naming projects and hours; one row per project with its total</td><td>exact</td><td>OOLONG-style aggregation</td></tr>
          <tr><td><code>finance-synthetic</code></td><td>20</td><td>a synthetic income statement over several years with distractor notes; one number (a sum, a growth rate, a ratio)</td><td>number</td><td>FinanceBench</td></tr>
          <tr><td><code>legal-synthetic</code></td><td>20</td><td>a synthetic contract with planted clause categories among near-misses; the set of categories present</td><td>exact</td><td>CUAD, Harvey LAB</td></tr>
          <tr><td><code>logbook-hard</code></td><td>30</td><td>about 1,650 log entries (30k tokens) in four phrasings with corrections; one of five aggregate questions</td><td>exact</td><td>OOLONG at a size that cannot be read once</td></tr>
          <tr><td><code>memo-rubric</code></td><td>20</td><td>a 40-section services agreement with planted terms, a rejected proposal and a superseding amendment; a short memo</td><td>judge</td><td>Harvey LAB drafting</td></tr>
          <tr><td><code>coding</code></td><td>12</td><td>a small Python project with visible tests; implement, extend, then fix a bug, in three-step episodes</td><td>shell (hidden tests)</td><td>SWE-bench</td></tr>
        </tbody>
      </table>
      </div>
      <p class="dim small">The synthetic packs are frozen generator output, so two people see the same tasks in the same order. The external datasets they imitate are not redistributed; OOLONG, Harvey LAB and contract redlining import on demand with <code>bench import-*</code>. The full description is in <a href="/docs/benchmarks/">the benchmark doc</a>.</p>
    </details>

    <details class="section" id="sec-runs">
      <summary><b>The runs and their plots</b> <span class="dim">when and how each model ran, the five <code>bench plot</code> charts</span></summary>
      {MODELS.map((r) => (
        <section class="run" data-model={r.id}>
          <h3>{r.label}</h3>
          <p class="dim small"><b>{r.date}.</b> {r.note}. Rows: {r.csvs.map((c, i) => (<>{i > 0 ? ", " : ""}<a href={`https://github.com/MarcusElwin/kleene/blob/main/${c}`}><code>{c}</code></a></>))}.</p>
          <div class="plots">
            {PLOTS.map(([file, title, what]) => (
              <figure>
                <a href={`/${r.plots}/${file}`}><img src={`/${r.plots}/${file}`} alt={`${title}, ${r.label}`} loading="lazy" /></a>
                <figcaption><b>{title}</b>: {what}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      ))}
    </details>

    <details class="section" id="sec-repro">
      <summary><b>Reproduce</b> <span class="dim">run a pack, export the rows, rebuild the tables</span></summary>
      <Terminal title="sh">
<span class="cmt"># a pack, one mode, with a fresh store per mode</span>&#10;<span class="prompt">$</span> kleene bench run tasks/oolong-like --mode frozen&#10;<span class="prompt">$</span> kleene bench run tasks/oolong-like --mode learning&#10;<span class="prompt">$</span> kleene bench run tasks/oolong-like --mode plain&#10;&#10;<span class="cmt"># the table, the rows and the plots</span>&#10;<span class="prompt">$</span> kleene bench report&#10;<span class="prompt">$</span> kleene bench csv > plots/&lt;model-date&gt;/evals.csv&#10;<span class="prompt">$</span> kleene bench plot plots/&lt;model-date&gt;&#10;&#10;<span class="cmt"># the README's results block and Pareto plots from every committed CSV</span>&#10;<span class="prompt">$</span> kleene bench results plots/*/evals.csv plots/evals.csv --out plots/results --readme README.md</Terminal>
      <p class="small">A learning run replays candidates against earlier tasks, so budget about $45 for a full sweep of the first four packs at <code>replay_sample 3</code>, and use <code>bench run --resume &lt;run-id&gt;</code> after an interruption. Every model call is memoised, so a second run of the same pack in the same store is free, which is also why a clean comparison wants a fresh store per mode. How the harness works is in <a href="/docs/benchmarks/">the benchmark doc</a>.</p>
    </details>

    <noscript><p class="dim">The charts and filters need JavaScript; the same numbers are in <a href="https://github.com/MarcusElwin/kleene/blob/main/plots/results/results.md">plots/results/results.md</a>.</p></noscript>
    <div class="tip" id="tip" hidden></div>
  </div>
</Base>

<script>
  // Everything below the toolbar is drawn from the cells embedded in
  // data-bench and redrawn whenever a filter, preset or metric changes.
  // The selection round-trips through the URL hash so a view can be linked.
  const root = document.getElementById("bench")!;
  const { cells, packs, modes, models, hard } = JSON.parse(root.dataset.bench!) as {
    cells: any[]; packs: string[]; modes: string[]; models: { id: string; label: string }[]; hard: string[];
  };
  const MODE_COLOR: Record<string, string> = { learning: "#cba6f7", frozen: "#fab387", plain: "#74c7ec" };
  const SHAPES = ["circle", "diamond", "triangle", "square"];
  const SHAPE_GLYPH: Record<string, string> = { circle: "●", diamond: "◆", triangle: "▲", square: "■" };
  const shapeOf = (model: string) => SHAPES[Math.min(Math.max(models.findIndex((m) => m.id === model), 0), SHAPES.length - 1)];
  const labelOf = (model: string) => models.find((m) => m.id === model)?.label ?? model;
  const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");
  const money = (x: number) => (x >= 1 ? `$${x.toFixed(2)}` : x >= 0.01 ? `$${x.toFixed(3)}` : `$${x.toFixed(4)}`);
  const int = (x: number) => Math.round(x).toLocaleString("en-US");
  const pct = (x: number) => `${Math.round(x * 100)}%`;

  type MetricKey = "pass" | "dollars" | "calls" | "seconds";
  const METRICS: Record<MetricKey, { label: string; of: (c: any) => number; fmt: (v: number) => string; higherIsBetter: boolean; absolute?: number }> = {
    pass: { label: "pass rate", of: (c) => c.pass, fmt: pct, higherIsBetter: true, absolute: 1 },
    dollars: { label: "dollars per task", of: (c) => c.dollarsPerTask, fmt: money, higherIsBetter: false },
    calls: { label: "calls per task", of: (c) => c.callsPerTask, fmt: (v) => v.toFixed(1), higherIsBetter: false },
    seconds: { label: "seconds per task", of: (c) => c.secondsPerTask, fmt: (v) => `${v.toFixed(1)} s`, higherIsBetter: false },
  };

  const all = (): Record<string, Set<string>> => ({ model: new Set(models.map((m) => m.id)), mode: new Set(modes), pack: new Set(packs) });
  let sel = all();
  let metric: MetricKey = "pass";
  let sortKey = "", sortDir = 1;
  const options: Record<string, { id: string; label: string }[]> = {
    model: models.map((m) => ({ id: m.id, label: m.label })),
    mode: modes.map((m) => ({ id: m, label: m })),
    pack: packs.map((p) => ({ id: p, label: p })),
  };
  const PRESETS: Record<string, () => void> = {
    all: () => { sel = all(); },
    hard: () => { sel = all(); sel.pack = new Set(packs.filter((p) => hard.includes(p))); },
    playbook: () => { sel = all(); sel.mode = new Set(["learning", "frozen"]); metric = "calls"; },
    abstraction: () => { sel = all(); sel.mode = new Set(["frozen", "plain"]); metric = "pass"; },
  };
  const activePreset = () => {
    const full = (k: string) => sel[k].size === options[k].length;
    if (full("model") && full("mode") && full("pack")) return "all";
    if (full("model") && full("mode") && [...sel.pack].every((p) => hard.includes(p)) && sel.pack.size === packs.filter((p) => hard.includes(p)).length) return "hard";
    if (full("model") && full("pack") && sel.mode.size === 2 && sel.mode.has("learning") && sel.mode.has("frozen")) return "playbook";
    if (full("model") && full("pack") && sel.mode.size === 2 && sel.mode.has("frozen") && sel.mode.has("plain")) return "abstraction";
    return "";
  };

  // URL hash: #metric=calls&mode=learning,frozen&pack=coding (absent = everything).
  function readHash() {
    const h = new URLSearchParams(location.hash.slice(1));
    sel = all();
    for (const key of Object.keys(options)) {
      const v = h.get(key);
      if (!v) continue;
      const ids = v.split(",").filter((id) => options[key].some((o) => o.id === id));
      if (ids.length) sel[key] = new Set(ids);
    }
    const m = h.get("metric") as MetricKey | null;
    if (m && METRICS[m]) metric = m;
  }
  function writeHash() {
    const h = new URLSearchParams();
    for (const key of Object.keys(options)) if (sel[key].size < options[key].length) h.set(key, options[key].filter((o) => sel[key].has(o.id)).map((o) => o.id).join(","));
    if (metric !== "pass") h.set("metric", metric);
    const s = h.toString();
    history.replaceState(null, "", s ? `#${s}` : location.pathname + location.search);
  }

  function chips() {
    for (const key of Object.keys(options)) {
      const host = root.querySelector<HTMLElement>(`[data-filter="${key}"]`)!;
      host.innerHTML = options[key].map((o) => {
        const on = sel[key].has(o.id);
        const sw = key === "mode" ? `<i style="background:${MODE_COLOR[o.id]}"></i>` : key === "model" ? `<i class="g">${SHAPE_GLYPH[shapeOf(o.id)]}</i>` : "";
        return `<button type="button" class="chip${on ? " on" : ""}" data-key="${key}" data-id="${esc(o.id)}" aria-pressed="${on}">${sw}${esc(o.label)}</button>`;
      }).join("");
    }
    const preset = activePreset();
    root.querySelectorAll<HTMLElement>("[data-preset]").forEach((b) => { b.classList.toggle("on", b.dataset.preset === preset); b.setAttribute("aria-pressed", String(b.dataset.preset === preset)); });
    root.querySelectorAll<HTMLElement>("[data-m]").forEach((b) => { b.classList.toggle("on", b.dataset.m === metric); b.setAttribute("aria-checked", String(b.dataset.m === metric)); });
    const off = Object.keys(options).reduce((a, k) => a + (options[k].length - sel[k].size), 0);
    document.getElementById("fcount")!.textContent = off ? `· ${off} hidden` : "";
  }
  root.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    const p = t.closest<HTMLElement>("[data-preset]");
    if (p) { PRESETS[p.dataset.preset!](); draw(); return; }
    const m = t.closest<HTMLElement>("[data-m]");
    if (m) { metric = m.dataset.m as MetricKey; draw(); return; }
    const b = t.closest<HTMLElement>(".chip[data-key]");
    if (!b) return;
    const key = b.dataset.key!, id = b.dataset.id!;
    // Shift/alt-click solos; a plain click toggles. Never leave a group empty.
    if (e.altKey || e.shiftKey) { sel[key] = new Set([id]); }
    else if (sel[key].has(id)) { if (sel[key].size > 1) sel[key].delete(id); }
    else sel[key].add(id);
    draw();
  });
  document.getElementById("reset")!.addEventListener("click", () => { sel = all(); metric = "pass"; draw(); });
  document.querySelector("#table thead")!.addEventListener("click", (e) => {
    const th = (e.target as HTMLElement).closest<HTMLElement>("th[data-sort]");
    if (!th) return;
    const k = th.dataset.sort!;
    if (sortKey === k) sortDir = -sortDir; else { sortKey = k; sortDir = ["pack", "mode", "label"].includes(k) ? 1 : -1; }
    draw();
  });

  const visible = () => cells.filter((c) => sel.model.has(c.model) && sel.mode.has(c.mode) && sel.pack.has(c.pack));
  const vmodes = () => modes.filter((m) => sel.mode.has(m));
  const vmodels = () => models.filter((m) => sel.model.has(m.id));
  const vpacks = () => packs.filter((p) => sel.pack.has(p));

  function mark(shape: string, x: number, y: number, color: string, r = 5) {
    const ring = `stroke="#181825" stroke-width="2"`;
    if (shape === "diamond") return `<path d="M${x} ${y - r - 1} L${x + r + 1} ${y} L${x} ${y + r + 1} L${x - r - 1} ${y} Z" fill="${color}" ${ring}/>`;
    if (shape === "triangle") return `<path d="M${x} ${y - r - 1} L${x + r + 1} ${y + r} L${x - r - 1} ${y + r} Z" fill="${color}" ${ring}/>`;
    if (shape === "square") return `<rect x="${x - r}" y="${y - r}" width="${2 * r}" height="${2 * r}" fill="${color}" ${ring}/>`;
    return `<circle cx="${x}" cy="${y}" r="${r}" fill="${color}" ${ring}/>`;
  }
  const tipText = (c: any) => `<b>${esc(c.pack)}</b> · ${esc(labelOf(c.model))} · <span style="color:${MODE_COLOR[c.mode]}">${c.mode}</span><br>${c.solved}/${c.tasks} solved (${pct(c.pass)})<br>${money(c.dollarsPerTask)} per task, ${money(c.dollars)} total<br>${c.callsPerTask.toFixed(1)} calls, ${int(c.tokensPerTask)} tokens, ${c.secondsPerTask.toFixed(1)} s per task`;

  // The matrix: one row per pack, one column per model, one bar per mode in each cell.
  function matrix(vis: any[]) {
    const M = METRICS[metric];
    const ms = vmodes(), mdl = vmodels(), ps = vpacks();
    const head = `<tr><th>pack</th>${mdl.map((m) => `<th>${SHAPE_GLYPH[shapeOf(m.id)]} ${esc(m.label)}</th>`).join("")}</tr>`;
    const body = ps.map((p) => {
      const row = vis.filter((c) => c.pack === p);
      if (!row.length) return "";
      const tasks = Math.max(...row.map((c) => c.tasks));
      const max = M.absolute ?? Math.max(...row.map(M.of), 1e-9);
      const cols = mdl.map((m) => {
        const mine = ms.map((mode) => row.find((c) => c.model === m.id && c.mode === mode));
        if (mine.every((c) => !c)) return `<td class="cell empty"><span class="dim">not run</span></td>`;
        // The outline marks the best mode for this model on this pack: the comparison the modes exist for.
        const vals = mine.filter(Boolean).map(M.of);
        const best = M.higherIsBetter ? Math.max(...vals) : Math.min(...vals);
        const tie = vals.every((v) => Math.abs(v - best) < 1e-12);
        return `<td class="cell">${ms.map((mode, i) => {
          const c = mine[i];
          if (!c) return `<div class="bar none"><i></i><span class="dim">${mode}: not run</span></div>`;
          const v = M.of(c), w = Math.max(1.5, Math.min(100, (v / max) * 100));
          const isBest = !tie && Math.abs(v - best) < 1e-12;
          return `<div class="bar mk${isBest ? " best" : ""}" data-cell="${cells.indexOf(c)}" tabindex="0" title=""><i style="width:${w}%;background:${MODE_COLOR[mode]}"></i><span><b>${M.fmt(v)}</b> <em>${mode}</em>${metric === "pass" ? ` <em class="dim">${c.solved}/${c.tasks}</em>` : ""}</span></div>`;
        }).join("")}</td>`;
      }).join("");
      return `<tr><th scope="row"><code>${esc(p)}</code><span class="dim">${tasks} tasks${hard.includes(p) ? " · hard" : ""}</span></th>${cols}</tr>`;
    }).join("");
    document.querySelector("#matrix thead")!.innerHTML = head;
    document.querySelector("#matrix tbody")!.innerHTML = body || `<tr><td class="dim">Nothing matches these filters.</td></tr>`;
    const better = M.higherIsBetter ? "higher" : "lower";
    document.getElementById("matrix-note")!.textContent = `${M.label[0].toUpperCase()}${M.label.slice(1)} per pack and model, one bar per mode${M.absolute ? "" : ", scaled to the pack's largest value"}. ${better[0].toUpperCase()}${better.slice(1)} is better; the best mode for each model is outlined. Hover a bar for every number of that cell.`;
  }

  function pareto(pack: string, pts: any[]) {
    const W = 320, H = 220, L = 44, R = 16, T = 28, B = 36;
    const xmax = Math.max(0.02, ...pts.map((p) => p.dollarsPerTask)) * 1.25;
    const xs = (v: number) => L + (v / xmax) * (W - L - R);
    const ys = (v: number) => T + (1 - v) * (H - T - B);
    const out: string[] = [`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(pack)}: pass rate against dollars per task" font-family="IBM Plex Mono, monospace" font-size="10">`];
    for (const v of [0, 0.5, 1]) out.push(`<line x1="${L}" x2="${W - R}" y1="${ys(v)}" y2="${ys(v)}" stroke="#313244"/><text x="${L - 6}" y="${ys(v) + 3}" text-anchor="end" fill="#a6adc8">${v * 100}%</text>`);
    for (const v of [0, xmax / 2, xmax]) out.push(`<text x="${xs(v)}" y="${H - B + 14}" text-anchor="middle" fill="#a6adc8">$${v.toFixed(2)}</text>`);
    out.push(`<line x1="${L}" x2="${W - R}" y1="${ys(0)}" y2="${ys(0)}" stroke="#45475a"/><text x="${(L + W - R) / 2}" y="${H - 4}" text-anchor="middle" fill="#6c7086">dollars per task</text>`);
    const placed: { x: number; y: number }[] = [];
    pts.forEach((p) => {
      const x = xs(p.dollarsPerTask), y = ys(p.pass);
      let dy = -9;
      for (const q of placed) if (Math.abs(q.x - x) < 40 && Math.abs(q.y - y) < 14) dy = 16;
      placed.push({ x, y });
      out.push(`<g class="mk" data-cell="${cells.indexOf(p)}" tabindex="0"><circle cx="${x}" cy="${y}" r="12" fill="transparent"/>${mark(shapeOf(p.model), x, y, MODE_COLOR[p.mode])}<text x="${x}" y="${y + dy}" text-anchor="middle" fill="#cdd6f4">${p.mode}</text></g>`);
    });
    out.push(`</svg>`);
    return out.join("");
  }

  function bars(model: string, vis: any[]) {
    const ps = packs.filter((p) => vis.some((c) => c.pack === p && c.model === model));
    if (!ps.length) return "";
    const ms = vmodes();
    const W = 640, L = 150, R = 60, rowH = 16, gap = 12, T = 8;
    const H = T + ps.length * (ms.length * rowH + gap) + 24;
    const vmax = Math.max(1, ...vis.filter((c) => c.model === model).map((c) => c.callsPerTask)) * 1.1;
    const xs = (v: number) => L + (v / vmax) * (W - L - R);
    const out = [`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="calls per task by mode and pack, ${esc(labelOf(model))}" font-family="IBM Plex Mono, monospace" font-size="11">`];
    for (const v of [0, Math.round(vmax / 2), Math.round(vmax)]) out.push(`<line x1="${xs(v)}" x2="${xs(v)}" y1="${T}" y2="${H - 20}" stroke="#313244"/><text x="${xs(v)}" y="${H - 6}" text-anchor="middle" fill="#a6adc8">${v}</text>`);
    ps.forEach((p, i) => {
      const y0 = T + i * (ms.length * rowH + gap);
      out.push(`<text x="${L - 10}" y="${y0 + (ms.length * rowH) / 2 + 4}" text-anchor="end" fill="#cdd6f4">${esc(p)}</text>`);
      ms.forEach((m, j) => {
        const c = vis.find((c) => c.pack === p && c.model === model && c.mode === m);
        const y = y0 + j * rowH;
        if (!c) { out.push(`<text x="${L + 4}" y="${y + 12}" fill="#6c7086">${m}: not run</text>`); return; }
        const w = Math.max(2, xs(c.callsPerTask) - L);
        out.push(`<g class="mk" data-cell="${cells.indexOf(c)}" tabindex="0"><rect x="${L}" y="${y + 2}" width="${w}" height="${rowH - 4}" rx="2" fill="${MODE_COLOR[m]}"/><text x="${L + w + 6}" y="${y + 12}" fill="#cdd6f4">${c.callsPerTask.toFixed(1)} <tspan fill="#6c7086">${m}</tspan></text></g>`);
      });
    });
    out.push(`</svg>`);
    return `<figure class="bars"><figcaption>${esc(labelOf(model))}</figcaption>${out.join("")}</figure>`;
  }

  function table(vis: any[]) {
    const rows = [...vis];
    if (sortKey) rows.sort((a, b) => { const x = a[sortKey], y = b[sortKey]; return (typeof x === "number" ? x - y : String(x).localeCompare(String(y))) * sortDir; });
    document.querySelectorAll<HTMLElement>("#table th[data-sort]").forEach((th) => { th.dataset.dir = th.dataset.sort === sortKey ? (sortDir > 0 ? "asc" : "desc") : ""; });
    document.querySelector("#table tbody")!.innerHTML = rows.map((c) => `<tr><td><code>${esc(c.pack)}</code></td><td><span class="swatch" style="background:${MODE_COLOR[c.mode]}"></span>${c.mode}</td><td>${esc(labelOf(c.model))}</td><td class="n">${c.solved}/${c.tasks} <span class="dim">(${pct(c.pass)})</span></td><td class="n">${money(c.dollarsPerTask)}</td><td class="n">${money(c.dollars)}</td><td class="n">${c.callsPerTask.toFixed(1)}</td><td class="n">${int(c.tokensPerTask)}</td><td class="n">${c.secondsPerTask.toFixed(1)}</td></tr>`).join("");
  }

  function draw() {
    chips();
    writeHash();
    const vis = visible();
    const tasks = vis.reduce((a, c) => a + c.tasks, 0);
    const solved = vis.reduce((a, c) => a + c.solved, 0);
    const dollars = vis.reduce((a, c) => a + c.dollars, 0);
    const calls = vis.reduce((a, c) => a + c.callsPerTask * c.tasks, 0);
    document.getElementById("tiles")!.innerHTML = [
      [`${vmodels().length} × ${vpacks().filter((p) => vis.some((c) => c.pack === p)).length}`, "models × packs shown"],
      [String(tasks), "task runs"],
      [tasks ? pct(solved / tasks) : "–", `solved (${solved}/${tasks})`],
      [int(calls), "model calls"],
      [money(dollars), "spend counted (gate replays excluded)"],
    ].map(([b, s]) => `<div class="tile"><b>${b}</b><span>${s}</span></div>`).join("");
    matrix(vis);
    document.getElementById("legend")!.innerHTML = vmodes().map((m) => `<span><i style="background:${MODE_COLOR[m]}"></i>${m}</span>`).join("") + `<span class="dim">${vmodels().map((m) => `${SHAPE_GLYPH[shapeOf(m.id)]} ${esc(m.label)}`).join(" &nbsp; ")}</span>`;
    document.getElementById("panels")!.innerHTML = vpacks().map((p) => {
      const pts = vis.filter((c) => c.pack === p);
      if (!pts.length) return "";
      return `<figure class="panel"><figcaption><b>${esc(p)}</b> <span class="dim">${Math.max(...pts.map((c) => c.tasks))} tasks</span></figcaption>${pareto(p, pts)}</figure>`;
    }).join("") || `<p class="dim">Nothing matches these filters.</p>`;
    document.getElementById("bars")!.innerHTML = vmodels().map((m) => bars(m.id, vis)).join("");
    table(vis);
    root.querySelectorAll<HTMLElement>(".run").forEach((r) => { r.hidden = !sel.model.has(r.dataset.model!); });
  }

  // Tooltip: follows the pointer over a mark, pins on click, closes on Escape or a click elsewhere.
  const tip = document.getElementById("tip")!;
  let pinned = false;
  function showTip(el: HTMLElement, x: number, y: number) {
    const c = cells[Number(el.dataset.cell)];
    tip.innerHTML = tipText(c);
    tip.hidden = false;
    const w = tip.offsetWidth, h = tip.offsetHeight;
    const px = Math.min(x + 14, window.innerWidth - w - 8), py = y - h - 12 > 8 ? y - h - 12 : y + 18;
    tip.style.left = `${px + window.scrollX}px`; tip.style.top = `${py + window.scrollY}px`;
  }
  root.addEventListener("pointermove", (e) => {
    if (pinned) return;
    const m = (e.target as Element).closest<HTMLElement>(".mk");
    if (m) showTip(m, e.clientX, e.clientY); else tip.hidden = true;
  });
  root.addEventListener("click", (e) => {
    const m = (e.target as Element).closest<HTMLElement>(".mk");
    if (m) { pinned = true; showTip(m, e.clientX, e.clientY); }
    else { pinned = false; tip.hidden = true; }
  });
  root.addEventListener("focusin", (e) => { const m = (e.target as Element).closest<HTMLElement>(".mk"); if (m) { const r = m.getBoundingClientRect(); showTip(m, r.left + r.width / 2, r.top); } });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") { pinned = false; tip.hidden = true; } });
  window.addEventListener("hashchange", () => { readHash(); draw(); });

  readHash();
  if (activePreset() !== "all") (document.getElementById("more") as HTMLDetailsElement).open = true;
  draw();
</script>

